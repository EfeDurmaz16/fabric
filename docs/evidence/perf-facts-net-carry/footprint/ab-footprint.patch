+/// SCRATCH: the physical footprint of `pid` and its peak, in KiB, as `footprint` reports them.
+fn footprint_kib(pid: u32) -> Fallible<(u64, u64)> {
+    let output = Command::new("/usr/bin/footprint")
+        .args(["-p", &pid.to_string(), "-f", "bytes", "--noCategories"])
+        .output()?;
+    let text = String::from_utf8(output.stdout)?;
+    let field = |name: &str| -> Fallible<u64> {
+        let line = text
+            .lines()
+            .find(|line| line.trim_start().starts_with(name))
+            .ok_or("no footprint line")?;
+        let bytes: u64 = line.trim().trim_start_matches(name).trim().trim_end_matches('B').trim().parse()?;
+        Ok(bytes / 1024)
+    };
+    Ok((field("phys_footprint:")?, field("phys_footprint_peak:")?))
+}
