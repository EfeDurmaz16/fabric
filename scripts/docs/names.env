# The product's names, in one place. The product name is not final; a
# rename changes this file, and the docs scripts and the docs site read
# every name from here: the site's title, the CLI binary the reference is
# generated from, and the repository its links point at.
PRODUCT_NAME=Fabric
CLI_BIN=fabric
CLI_PACKAGE=fabric
REPO_URL=https://github.com/EfeDurmaz16/fabric
