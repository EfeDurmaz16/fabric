{
  "name": "@fabric/client",
  "version": "0.1.0",
  "description": "TypeScript client for the client API of a local Fabric node (ADR 0018)",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  }
}
