{
  "case": "hello_ack_wrong_profile",
  "direction": "worker_to_fabric",
  "phase": "handshake",
  "expect": {
    "outcome": "reject",
    "code": "protocol_violation",
    "reason": "profile_mismatch"
  },
  "message": {
    "type": "hello_ack",
    "protocol": 1,
    "worker": "capsule-worker/0.1.0",
    "profile": {
      "profile": "docker",
      "version": 1,
      "provider": "docker",
      "scope_keys": [
        "engine"
      ],
      "resource_kinds": [
        "container"
      ],
      "clock": "wall",
      "observe_interval_ms": 250,
      "image_pull": "never",
      "actions": [
        {
          "action": "sandbox.create",
          "effect": "create",
          "terminal_only": true,
          "observe": true,
          "cancel": false,
          "approval": "optional",
          "dedupe": "label_query",
          "secrets": true
        },
        {
          "action": "sandbox.exec",
          "effect": "mutate",
          "terminal_only": false,
          "observe": false,
          "cancel": false,
          "approval": "optional",
          "dedupe": "none",
          "secrets": true
        },
        {
          "action": "sandbox.destroy",
          "effect": "destroy",
          "terminal_only": true,
          "observe": true,
          "cancel": false,
          "approval": "required",
          "dedupe": "label_query",
          "secrets": false
        }
      ],
      "limits": {
        "max_deadline_ms": 600000,
        "max_observe_wait_ms": 30000,
        "max_output_bytes": 1048576,
        "max_stdin_bytes": 65536,
        "max_argv": 64,
