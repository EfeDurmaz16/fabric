{
  "profile": "docker",
  "version": 1,
  "provider": "docker",
  "scope_keys": [
    "engine"
  ],
  "resource_kinds": [
    "container"
  ],
  "clock": "wall",
  "observe_interval_ms": 250,
  "image_pull": "never",
  "actions": [
    {
      "action": "sandbox.create",
      "effect": "create",
      "terminal_only": true,
      "observe": true,
      "cancel": false,
      "approval": "optional",
      "dedupe": "label_query",
      "secrets": true
    },
    {
      "action": "sandbox.exec",
      "effect": "mutate",
      "terminal_only": false,
      "observe": true,
      "cancel": false,
      "approval": "optional",
      "dedupe": "none",
      "secrets": true
    },
    {
      "action": "sandbox.destroy",
      "effect": "destroy",
      "terminal_only": true,
      "observe": true,
      "cancel": false,
      "approval": "required",
      "dedupe": "label_query",
      "secrets": false
    }
  ],
  "limits": {
    "max_deadline_ms": 600000,
    "max_observe_wait_ms": 30000,
    "max_output_bytes": 1048576,
    "max_stdin_bytes": 65536,
    "max_argv": 64,
    "max_receipts": 16
  }
}
